[Unit]
Description=Accept bounded MiniSago deployment requests

[Socket]
ListenStream=/run/sago-cloud/minisago-deploy.sock
Accept=yes
DirectoryMode=0750
SocketMode=0660
SocketUser=ubuntu
# The oven/bun worker runs with GID 1000; the host ubuntu GID may differ.
SocketGroup=1000
RemoveOnStop=true

[Install]
WantedBy=sockets.target
