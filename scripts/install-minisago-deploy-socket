#!/usr/bin/env bash
set -euo pipefail

source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

if [[ "$(id -u)" -eq 0 ]]; then
  SUDO=()
else
  SUDO=(sudo -n)
fi

"${SUDO[@]}" install -o root -g root -m 0755 \
  "$OPERATIONS_ROOT/scripts/accept-minisago-deploy-request" \
  /usr/local/libexec/sago-cloud-minisago-deploy
"${SUDO[@]}" install -d -o ubuntu -g ubuntu -m 0755 \
  "$STATE_ROOT/minisago-deploy"
"${SUDO[@]}" install -o root -g root -m 0644 \
  "$OPERATIONS_ROOT/systemd/sago-cloud-minisago-deploy.socket" \
  /etc/systemd/system/sago-cloud-minisago-deploy.socket
"${SUDO[@]}" install -o root -g root -m 0644 \
  "$OPERATIONS_ROOT/systemd/sago-cloud-minisago-deploy@.service" \
  /etc/systemd/system/sago-cloud-minisago-deploy@.service
"${SUDO[@]}" systemctl daemon-reload
"${SUDO[@]}" systemctl enable --now sago-cloud-minisago-deploy.socket
# Apply permissions to an already-active socket without replacing the inode
# bind-mounted into the worker. The unit sets the same group on future starts.
"${SUDO[@]}" chgrp 1000 /run/sago-cloud/minisago-deploy.sock
"${SUDO[@]}" chmod 0660 /run/sago-cloud/minisago-deploy.sock
"${SUDO[@]}" systemctl status sago-cloud-minisago-deploy.socket --no-pager
